<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarRegistro"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/azul_login"
        app:title="Nuevo usuario"
        app:titleTextColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvNombreUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre usuario:"
        android:textColor="@color/color_texto"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/toolbarRegistro"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="65dp"
        android:layout_marginStart="70dp" />

    <EditText
        android:id="@+id/edtNombreUsuario"
        android:layout_width="210dp"
        android:layout_height="wrap_content"
        android:hint="Ingrese usuario"
        android:inputType="text"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvNombreUsuario"
        app:layout_constraintStart_toStartOf="@id/tvNombreUsuario"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/tvEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email"
        android:textColor="@color/color_texto"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/edtNombreUsuario"
        app:layout_constraintStart_toStartOf="@id/edtNombreUsuario"
        android:layout_marginTop="22dp" />

    <EditText
        android:id="@+id/edtEmail"
        android:layout_width="210dp"
        android:layout_height="wrap_content"
        android:hint="Ingrese de email"
        android:inputType="textEmailAddress"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvEmail"
        app:layout_constraintStart_toStartOf="@id/tvEmail"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/tvPasswordRegistro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password"
        android:textColor="@color/color_texto"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/edtEmail"
        app:layout_constraintStart_toStartOf="@id/edtEmail"
        android:layout_marginTop="22dp" />

    <EditText
        android:id="@+id/edtPasswordRegistro"
        android:layout_width="210dp"
        android:layout_height="wrap_content"
        android:hint="Ingrese de password"
        android:inputType="textPassword"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvPasswordRegistro"
        app:layout_constraintStart_toStartOf="@id/tvPasswordRegistro"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/tvConfirmarPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirmar Password"
        android:textColor="@color/color_texto"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/edtPasswordRegistro"
        app:layout_constraintStart_toStartOf="@id/edtPasswordRegistro"
        android:layout_marginTop="22dp" />

    <EditText
        android:id="@+id/edtConfirmarPassword"
        android:layout_width="210dp"
        android:layout_height="wrap_content"
        android:hint="Repita el password"
        android:inputType="textPassword"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvConfirmarPassword"
        app:layout_constraintStart_toStartOf="@id/tvConfirmarPassword"
        android:layout_marginTop="5dp" />

    <Button
        android:id="@+id/btnGuardarUsuario"
        android:layout_width="115dp"
        android:layout_height="wrap_content"
        android:text="Guardar"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/edtConfirmarPassword"
        app:layout_constraintStart_toStartOf="@id/edtConfirmarPassword"
        android:layout_marginTop="45dp" />

    <Button
        android:id="@+id/btnRegresar"
        android:layout_width="115dp"
        android:layout_height="wrap_content"
        android:text="Regresar"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="@id/btnGuardarUsuario"
        app:layout_constraintStart_toEndOf="@id/btnGuardarUsuario"
        android:layout_marginStart="25dp" />

</androidx.constraintlayout.widget.ConstraintLayout>